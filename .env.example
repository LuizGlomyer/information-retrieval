# ── Elasticsearch ────────────────────────────────────────────
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_HOST_PORT=9200

# ── Kibana ───────────────────────────────────────────────────
KIBANA_PORT=5601

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_PORT=8080           
BACKEND_INTERNAL_PORT=8080

# ── Frontend (Vite) ──────────────────────────────────────────
FRONTEND_PORT=8090
FRONTEND_INTERNAL_PORT=8090

# ── Dataset ──────────────────────────────────────────────────
CSV_PATH=/app/data/game_dataset_cleaned.csv

# ── Gemini (qrels generation) ────────────────────────────────
GEMINI_API_KEY=your-token-here
